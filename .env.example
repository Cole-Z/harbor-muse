# Copy to .env (never commit it) or set these in your shell / host settings.
# Server-side only: hosted users never paste keys into the browser.

# Free at https://aisstream.io. Live ships near each viewer; without it the app runs the Corpus Christi replay demo.
AISSTREAM_API_KEY=

# Meta Muse key for the upcoming Ask feature (POST /ask returns 501 until wired).
MUSE_API_KEY=

PORT=3000
